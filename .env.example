# Copy to .env and fill in the values. .env is never committed.

# MinIO root credentials (object storage)
MINIO_ROOT_USER=sparkadmin
MINIO_ROOT_PASSWORD=change-me-minio

# Postgres in the cluster (source data and the ops ledger)
POSTGRES_USER=spark
POSTGRES_PASSWORD=change-me-postgres

# Airflow metadata DB (host Docker container on port 5433, independent of k3d)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow
AIRFLOW_DB_PORT=5433
